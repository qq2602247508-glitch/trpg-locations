{
  "$schema": "https://repomix.com/schemas/latest/schema.json",
  "output": {
    "filePath": "artifacts/context/repomix-output.xml",
    "style": "xml",
    "filePathStyle": "target-relative",
    "compress": true,
    "patterns": [
      {
        "pattern": "src/**/schema.ts",
        "compress": false
      },
      {
        "pattern": "package.json",
        "compress": false
      },
      {
        "pattern": "README.md",
        "compress": false
      }
    ],
    "fileSummary": true,
    "directoryStructure": true,
    "removeComments": false,
    "removeEmptyLines": true,
    "showLineNumbers": false,
    "truncateBase64": true,
    "copyToClipboard": false,
    "topFilesLength": 20,
    "tokenCountTree": 500,
    "tokenBudget": 120000,
    "git": {
      "sortByChanges": true,
      "sortByChangesMaxCommits": 100,
      "includeDiffs": false,
      "includeLogs": false
    }
  },
  "include": [
    "src/**/*",
    "docs/**/*",
    "evals/**/*",
    "package.json",
    "tsconfig*.json",
    "vite.config.*",
    "README.md"
  ],
  "ignore": {
    "useGitignore": true,
    "useDefaultPatterns": true,
    "customPatterns": [
      "artifacts/**",
      "dist/**",
      "coverage/**",
      "node_modules/**",
      "**/*.png",
      "**/*.jpg",
      "**/*.webp"
    ]
  },
  "security": {
    "enableSecurityCheck": true
  },
  "tokenCount": {
    "encoding": "o200k_base"
  }
}
